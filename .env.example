# Safe local-development examples only. Copy this file to .env and change as needed.
FLOWLENS_SERVICE_NAME=flowlens-api
FLOWLENS_APP_ENVIRONMENT=development
FLOWLENS_LOG_LEVEL=INFO
FLOWLENS_DATABASE_URL=postgresql+psycopg://flowlens:flowlens@localhost:5432/flowlens

# PostgreSQL container settings for local development only.
POSTGRES_DB=flowlens
POSTGRES_USER=flowlens
POSTGRES_PASSWORD=flowlens
POSTGRES_PORT=5432
